{
  "name": "react-native-pdf-renderer",
  "displayName": "React-Native Pdf Renderer",
  "version": "3.0.1",
  "description": "⚛ A zoomable, blazing fast, zero dependencies, pure native, typed PDF Renderer for Android and iOS.",
  "main": "src",
  "react-native": "src",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/douglasjunior/react-native-pdf-renderer.git"
  },
  "keywords": [
    "react-native",
    "android",
    "ios",
    "pdf",
    "PdfRenderer",
    "PdfKit"
  ],
  "author": {
    "name": "Douglas Nassif Roma Junior",
    "email": "nassifrroma@gmail.com",
    "url": "https://github.com/douglasjunior"
  },
  "bugs": {
    "url": "https://github.com/douglasjunior/react-native-pdf-renderer/issues"
  },
  "homepage": "https://github.com/douglasjunior/react-native-pdf-renderer",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "codegenConfig": {
    "name": "rnpdfrenderer_codegen",
    "type": "components",
    "jsSrcsDir": "./src/specs",
    "android": {
      "javaPackageName": "com.github.douglasjunior.reactNativePdfRenderer"
    },
    "ios": {
      "componentProvider": {
        "RNPdfRendererView": "RNPdfRendererComponentView"
      }
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "react-native": ">=0.80"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "yarn@1.22.22"
}
